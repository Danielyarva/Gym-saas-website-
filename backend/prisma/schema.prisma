generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum Role {
  COACH
  CLIENT
  ADMIN
}

enum ClientStatus {
  ON_TRACK
  NEEDS_ATTENTION
  AT_RISK
  INACTIVE
}

enum AuditAction {
  USER_REGISTERED
  USER_LOGIN
  USER_LOGOUT
  USER_LOGOUT_ALL
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  EMAIL_VERIFIED
  CLIENT_CREATED
  CLIENT_ARCHIVED
  CLIENT_UNARCHIVED
  CLIENT_STATUS_CHANGED
  CLIENT_NOTE_ADDED
  CLIENT_NOTE_UPDATED
  CLIENT_NOTE_DELETED
  CLIENT_INVITED
  CLIENT_INVITE_ACCEPTED
  ONBOARDING_COMPLETED
  WORKOUT_PLAN_ASSIGNED
  NUTRITION_PLAN_ASSIGNED
  CHECK_IN_SUBMITTED
  PROGRESS_PHOTO_UPLOADED
  PROGRESS_PHOTO_DELETED
  AI_CHAT_MESSAGE_SENT
  AI_INSIGHT_GENERATED
  AI_WEEKLY_REPORT_GENERATED
  MESSAGE_SENT
  SUBSCRIPTION_CHANGED
  PAYMENT_SUCCEEDED
}

enum SubscriptionPlan {
  STARTER
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

enum PaymentStatus {
  CREATED
  CAPTURED
  FAILED
}

enum MessageSenderRole {
  COACH
  CLIENT
}

enum NotificationType {
  CLIENT_CHECKIN
  CLIENT_AT_RISK
  MISSED_WORKOUT
  WEEKLY_REPORT
  NEW_MESSAGE
  SUBSCRIPTION
  SYSTEM
}

enum AiMessageRole {
  USER
  ASSISTANT
}

enum AiRiskLevel {
  GREEN
  YELLOW
  RED
}

enum GoalType {
  WEIGHT_LOSS
  MUSCLE_GAIN
  ENDURANCE
  STRENGTH
  MOBILITY
  GENERAL_FITNESS
  OTHER
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  ABANDONED
}

enum TrainingExperience {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ActivityLevel {
  SEDENTARY
  LIGHTLY_ACTIVE
  MODERATELY_ACTIVE
  VERY_ACTIVE
}

enum SleepQuality {
  POOR
  FAIR
  GOOD
  EXCELLENT
}

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  LEGS
  GLUTES
  CORE
  CARDIO
  FULL_BODY
  OTHER
}

enum EquipmentType {
  BARBELL
  DUMBBELL
  MACHINE
  CABLE
  BODYWEIGHT
  KETTLEBELL
  BAND
  OTHER
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum WorkoutPlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum WorkoutLogStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum NutritionPlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum MoodLevel {
  VERY_LOW
  LOW
  NEUTRAL
  GOOD
  VERY_GOOD
}

enum EnergyLevel {
  VERY_LOW
  LOW
  NEUTRAL
  GOOD
  VERY_GOOD
}

enum AdherenceLevel {
  POOR
  FAIR
  GOOD
  EXCELLENT
}

enum MeasurementSource {
  ONBOARDING
  CHECK_IN
  MANUAL
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String    @map("password_hash")
  role            Role
  emailVerified   Boolean   @default(false) @map("email_verified")
  emailVerifiedAt DateTime? @map("email_verified_at")
  isActive        Boolean   @default(true) @map("is_active")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  coach                   Coach?
  client                  Client?
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  auditLogs               AuditLog[]               @relation("AuditActor")
  notifications           Notification[]
  pushSubscriptions       PushSubscription[]

  // Phase 8 platform-wide admin analytics (new coaches/active coaches/WAU) —
  // role-scoped since those queries always filter by role first.
  @@index([role, createdAt])
  @@index([role, lastLoginAt])
  @@map("users")
}

model Coach {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  fullName     String   @map("full_name")
  businessName String?  @map("business_name")
  phone        String?
  avatarUrl    String?  @map("avatar_url")
  timezone     String   @default("UTC")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  coachClients       CoachClient[]
  clientNotes        ClientNote[]
  clientInviteTokens ClientInviteToken[]
  customExercises    Exercise[]
  workoutPlans       WorkoutPlan[]
  nutritionPlans     NutritionPlan[]
  subscription       Subscription?
  payments           Payment[]

  @@map("coaches")
}

model Client {
  id        String   @id @default(uuid()) @db.Uuid
  // Nullable: a coach can add a client as a roster record before that person
  // ever logs in. Populated once the Phase 2 onboarding invite flow links a
  // User to this Client — no migration needed when that ships.
  userId    String?  @unique @map("user_id") @db.Uuid
  fullName  String   @map("full_name")
  email     String   @unique
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user        User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  profile     ClientProfile?
  coachClient CoachClient?
  notes       ClientNote[]

  inviteTokens     ClientInviteToken[]
  onboarding       ClientOnboarding?
  goals            Goal[]
  bodyMeasurements BodyMeasurement[]
  workoutPlans     WorkoutPlan[]
  workoutLogs      WorkoutLog[]
  nutritionPlans   NutritionPlan[]
  dailyCheckIns    DailyCheckIn[]
  progressPhotos   ProgressPhoto[]
  aiConversation   AiConversation?
  aiInsights       AiInsight[]
  weeklyReports    WeeklyReport[]
  aiUsageLogs      AiUsageLog[]
  messages         Message[]

  @@map("clients")
}

model CoachClient {
  id       String @id @default(uuid()) @db.Uuid
  coachId  String @map("coach_id") @db.Uuid
  // Unique: Phase 1 supports exactly one coach per client. Also the DB-level
  // backstop for "a coach can only access their own clients" — every query
  // for a client goes through this row, scoped by coachId.
  clientId String @unique @map("client_id") @db.Uuid

  status ClientStatus @default(ON_TRACK)

  // Null = no data yet. Populated starting Phase 2 (check-ins) and Phase 4
  // (AI analysis). The API surfaces null as null, never a misleading 0.
  adherencePct  Int?      @map("adherence_pct")
  progressPct   Int?      @map("progress_pct")
  lastCheckInAt DateTime? @map("last_check_in_at")

  // Soft delete for "Archive client" — distinct from `status`, which tracks
  // engagement health while a client is still active on the roster.
  archivedAt DateTime? @map("archived_at")
  assignedAt DateTime  @default(now()) @map("assigned_at")

  // Typing indicator (Phase 5, PRD §20) without WebSockets: whichever side is
  // typing bumps their own column a few seconds into the future; the other
  // side's polled GET reports it "typing" while that timestamp is still
  // ahead of now. No dedicated table, no Redis — just two ephemeral columns
  // on the relationship they describe.
  coachTypingUntil  DateTime? @map("coach_typing_until")
  clientTypingUntil DateTime? @map("client_typing_until")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  coach  Coach  @relation(fields: [coachId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([coachId, status])
  @@index([coachId, archivedAt])
  // Phase 8 platform-wide active-client count — the composites above are
  // coachId-first, useless for a scan across every coach.
  @@index([archivedAt])
  @@map("coach_clients")
}

model ClientProfile {
  id       String @id @default(uuid()) @db.Uuid
  clientId String @unique @map("client_id") @db.Uuid

  avatarUrl   String?   @map("avatar_url")
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  gender      String?
  heightCm    Decimal?  @map("height_cm") @db.Decimal(5, 2)

  // Weight lives here (not gated behind check-in history) because the
  // dashboard and /clients list need starting/current/goal weight from day
  // one; check-in-driven weight history is a Phase 2 addition on top.
  startingWeightKg Decimal? @map("starting_weight_kg") @db.Decimal(5, 2)
  currentWeightKg  Decimal? @map("current_weight_kg") @db.Decimal(5, 2)
  goalWeightKg     Decimal? @map("goal_weight_kg") @db.Decimal(5, 2)
  goalText         String?  @map("goal_text")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_profiles")
}

model ClientNote {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  coachId   String   @map("coach_id") @db.Uuid
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  coach  Coach  @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@map("client_notes")
}

model RefreshToken {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  // Only the SHA-256 hash is stored — the raw token lives only in the cookie.
  tokenHash String @unique @map("token_hash")

  // Rotated (not deleted) tokens keep revokedAt set so a replay of an
  // already-used token can be detected (theft signal) instead of just failing.
  revokedAt           DateTime? @map("revoked_at")
  replacedByTokenHash String?   @map("replaced_by_token_hash")

  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  actorUserId String?     @map("actor_user_id") @db.Uuid
  action      AuditAction
  entityType  String?     @map("entity_type")
  entityId    String?     @map("entity_id") @db.Uuid
  metadata    Json?
  ipAddress   String?     @map("ip_address")
  userAgent   String?     @map("user_agent")
  createdAt   DateTime    @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Phase 2: client accounts (invite), onboarding, workout & nutrition plans,
// daily check-ins. See docs/PRD.md §11-14.
// ---------------------------------------------------------------------------

model ClientInviteToken {
  id               String    @id @default(uuid()) @db.Uuid
  clientId         String    @map("client_id") @db.Uuid
  invitedByCoachId String    @map("invited_by_coach_id") @db.Uuid
  tokenHash        String    @unique @map("token_hash")
  expiresAt        DateTime  @map("expires_at")
  usedAt           DateTime? @map("used_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  client         Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invitedByCoach Coach  @relation(fields: [invitedByCoachId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_invite_tokens")
}

model Goal {
  id          String     @id @default(uuid()) @db.Uuid
  clientId    String     @map("client_id") @db.Uuid
  type        GoalType
  targetValue Decimal?   @map("target_value") @db.Decimal(6, 2)
  targetUnit  String?    @map("target_unit")
  targetDate  DateTime?  @map("target_date") @db.Date
  notes       String?    @db.Text
  isPrimary   Boolean    @default(false) @map("is_primary")
  status      GoalStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, status])
  @@index([clientId, isPrimary])
  @@map("goals")
}

// Append-only time series (weight/measurements over time) so Phase 3's
// progress charts can read history with zero schema change — no chart
// or reporting logic is built against this table yet.
model BodyMeasurement {
  id         String            @id @default(uuid()) @db.Uuid
  clientId   String            @map("client_id") @db.Uuid
  recordedAt DateTime          @default(now()) @map("recorded_at")
  weightKg   Decimal?          @map("weight_kg") @db.Decimal(5, 2)
  waistCm    Decimal?          @map("waist_cm") @db.Decimal(5, 2)
  chestCm    Decimal?          @map("chest_cm") @db.Decimal(5, 2)
  armsCm     Decimal?          @map("arms_cm") @db.Decimal(5, 2)
  hipsCm     Decimal?          @map("hips_cm") @db.Decimal(5, 2)
  thighsCm   Decimal?          @map("thighs_cm") @db.Decimal(5, 2)
  source     MeasurementSource @default(MANUAL)
  notes      String?           @db.Text
  createdAt  DateTime          @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, recordedAt])
  @@map("body_measurements")
}

// Separate from ClientProfile (read on every /clients list row) since this
// is write-once/read-rarely wizard intake data. Step 1 (basic info) writes
// into Client/ClientProfile directly; steps 2-3 create Goal/BodyMeasurement
// rows; steps 4-9 live here.
model ClientOnboarding {
  id       String @id @default(uuid()) @db.Uuid
  clientId String @unique @map("client_id") @db.Uuid

  // Step 4: Training experience
  trainingExperience  TrainingExperience? @map("training_experience")
  trainingDaysPerWeek Int?                @map("training_days_per_week")

  // Step 5: Equipment
  equipmentList  String[] @map("equipment_list")
  equipmentNotes String?  @map("equipment_notes") @db.Text

  // Step 6: Nutrition preferences
  dietaryPreferences    String[] @map("dietary_preferences")
  allergies             String[]
  mealsPerDayPreference Int?     @map("meals_per_day_preference")

  // Step 7: Lifestyle
  activityLevel  ActivityLevel? @map("activity_level")
  occupationType String?        @map("occupation_type")
  stressLevel    Int?           @map("stress_level")

  // Step 8: Sleep baseline (distinct from DailyCheckIn.sleepHours, which is nightly actuals)
  typicalSleepHours Decimal?      @map("typical_sleep_hours") @db.Decimal(3, 1)
  sleepQuality      SleepQuality? @map("sleep_quality")

  // Step 9: Medical/safety — a self-attestation, never a diagnosis. Kept
  // deliberately narrow (training-relevant only) per PRD §11's instruction
  // not to collect unnecessary sensitive medical information.
  injuriesOrLimitations String?  @map("injuries_or_limitations") @db.Text
  clearedForExercise    Boolean? @map("cleared_for_exercise")
  needsMedicalClearance Boolean  @default(false) @map("needs_medical_clearance")

  // Wizard bookkeeping
  currentStep Int       @default(1) @map("current_step")
  completedAt DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_onboarding")
}

// Null coachId = global seeded library entry, usable by every coach.
// Non-null = a coach's own custom exercise, usable only by that coach.
model Exercise {
  id           String        @id @default(uuid()) @db.Uuid
  coachId      String?       @map("coach_id") @db.Uuid
  name         String
  muscleGroup  MuscleGroup   @map("muscle_group")
  equipment    EquipmentType
  difficulty   Difficulty
  instructions String?       @db.Text
  videoUrl     String?       @map("video_url")
  imageUrl     String?       @map("image_url")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  coach            Coach?            @relation(fields: [coachId], references: [id], onDelete: Cascade)
  workoutExercises WorkoutExercise[]

  @@index([muscleGroup])
  @@index([coachId])
  @@map("exercises")
}

model WorkoutPlan {
  id          String            @id @default(uuid()) @db.Uuid
  coachId     String            @map("coach_id") @db.Uuid
  clientId    String            @map("client_id") @db.Uuid
  name        String
  description String?           @db.Text
  status      WorkoutPlanStatus @default(DRAFT)
  startDate   DateTime?         @map("start_date") @db.Date
  endDate     DateTime?         @map("end_date") @db.Date
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  coach  Coach        @relation(fields: [coachId], references: [id], onDelete: Cascade)
  client Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  days   WorkoutDay[]

  @@index([coachId, clientId])
  @@index([clientId, status])
  @@map("workout_plans")
}

model WorkoutDay {
  id            String   @id @default(uuid()) @db.Uuid
  workoutPlanId String   @map("workout_plan_id") @db.Uuid
  label         String
  order         Int
  isRestDay     Boolean  @default(false) @map("is_rest_day")
  // 0(Sun)-6(Sat). Null = no fixed slot — "today" resolution falls back to
  // "next unlogged day in plan order." No full periodization scheduler here.
  dayOfWeek     Int?     @map("day_of_week")
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  workoutPlan WorkoutPlan       @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  exercises   WorkoutExercise[]
  logs        WorkoutLog[]

  @@index([workoutPlanId, order])
  @@map("workout_days")
}

model WorkoutExercise {
  id           String   @id @default(uuid()) @db.Uuid
  workoutDayId String   @map("workout_day_id") @db.Uuid
  exerciseId   String   @map("exercise_id") @db.Uuid
  order        Int
  sets         Int
  reps         String // "8-12", "AMRAP", "30s" — a format, not always a plain int
  weightKg     Decimal? @map("weight_kg") @db.Decimal(6, 2) // null = bodyweight
  restSeconds  Int?     @map("rest_seconds")
  tempo        String?
  notes        String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  workoutDay   WorkoutDay    @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)
  exercise     Exercise      @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  exerciseLogs ExerciseLog[]

  @@index([workoutDayId, order])
  @@map("workout_exercises")
}

// A client's actual per-day completion record against an assigned WorkoutDay.
model WorkoutLog {
  id           String           @id @default(uuid()) @db.Uuid
  clientId     String           @map("client_id") @db.Uuid
  workoutDayId String           @map("workout_day_id") @db.Uuid
  date         DateTime         @db.Date // calendar date, not a timestamp — avoids TZ ambiguity for "today" lookups
  status       WorkoutLogStatus @default(NOT_STARTED)
  completedAt  DateTime?        @map("completed_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  workoutDay   WorkoutDay    @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)
  exerciseLogs ExerciseLog[]

  @@unique([clientId, workoutDayId, date])
  @@index([clientId, date])
  @@map("workout_logs")
}

model ExerciseLog {
  id                String    @id @default(uuid()) @db.Uuid
  workoutLogId      String    @map("workout_log_id") @db.Uuid
  workoutExerciseId String    @map("workout_exercise_id") @db.Uuid
  completed         Boolean   @default(false)
  actualSets        Int?      @map("actual_sets")
  actualReps        String?   @map("actual_reps")
  actualWeightKg    Decimal?  @map("actual_weight_kg") @db.Decimal(6, 2)
  completedAt       DateTime? @map("completed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  workoutLog      WorkoutLog      @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)
  workoutExercise WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@unique([workoutLogId, workoutExerciseId])
  @@map("exercise_logs")
}

model NutritionPlan {
  id                 String              @id @default(uuid()) @db.Uuid
  coachId            String              @map("coach_id") @db.Uuid
  clientId           String              @map("client_id") @db.Uuid
  name               String
  status             NutritionPlanStatus @default(DRAFT)
  dailyWaterTargetMl Int?                @map("daily_water_target_ml")
  notes              String?             @db.Text
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  coach  Coach           @relation(fields: [coachId], references: [id], onDelete: Cascade)
  client Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  meals  NutritionMeal[]

  @@index([coachId, clientId])
  @@index([clientId, status])
  @@map("nutrition_plans")
}

model NutritionMeal {
  id              String   @id @default(uuid()) @db.Uuid
  nutritionPlanId String   @map("nutrition_plan_id") @db.Uuid
  type            MealType
  order           Int
  name            String? // custom label — needed since MealType.SNACK can repeat ("Snack 1", "Snack 2")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  nutritionPlan NutritionPlan   @relation(fields: [nutritionPlanId], references: [id], onDelete: Cascade)
  foods         NutritionFood[]

  @@index([nutritionPlanId, order])
  @@map("nutrition_meals")
}

model NutritionFood {
  id              String   @id @default(uuid()) @db.Uuid
  nutritionMealId String   @map("nutrition_meal_id") @db.Uuid
  name            String
  quantity        String // "150g", "1 cup" — one free-text field for MVP, not split qty+unit
  calories        Int
  proteinG        Decimal  @map("protein_g") @db.Decimal(6, 2)
  carbsG          Decimal  @map("carbs_g") @db.Decimal(6, 2)
  fatG            Decimal  @map("fat_g") @db.Decimal(6, 2)
  fiberG          Decimal  @map("fiber_g") @db.Decimal(6, 2)
  order           Int
  // Phase 4 AI-fill hook — unused/always false in Phase 2, reserved so
  // assigning an AI-suggested food never needs a migration later.
  aiGenerated     Boolean  @default(false) @map("ai_generated")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  nutritionMeal NutritionMeal @relation(fields: [nutritionMealId], references: [id], onDelete: Cascade)

  @@index([nutritionMealId, order])
  @@map("nutrition_foods")
}

model DailyCheckIn {
  id                 String          @id @default(uuid()) @db.Uuid
  clientId           String          @map("client_id") @db.Uuid
  date               DateTime        @db.Date
  weightKg           Decimal?        @map("weight_kg") @db.Decimal(5, 2)
  workoutCompleted   Boolean?        @map("workout_completed")
  steps              Int?
  sleepHours         Decimal?        @map("sleep_hours") @db.Decimal(3, 1)
  mood               MoodLevel?
  energy             EnergyLevel?
  nutritionAdherence AdherenceLevel? @map("nutrition_adherence")
  notes              String?         @db.Text
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  client    Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  aiInsight AiInsight[]

  @@unique([clientId, date])
  @@index([clientId, date])
  // Phase 8 platform-wide check-in rate — the index above is clientId-first,
  // useless for "distinct clients checked in since X" across every client.
  @@index([date])
  @@map("daily_checkins")
}

model ProgressPhoto {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  url       String
  takenAt   DateTime @map("taken_at") @db.Date
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, takenAt])
  @@map("progress_photos")
}

// One conversation per client (find-or-create on first chat message) — no
// need for multiple threads in an MVP.
model AiConversation {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @unique @map("client_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client   Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@map("ai_conversations")
}

model AiMessage {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @map("conversation_id") @db.Uuid
  role           AiMessageRole
  content        String        @db.Text
  createdAt      DateTime      @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

// One row per check-in-triggered analysis. Risk detection (PRD §18) is the
// riskLevel field inside this, not a separate pipeline — the PRD's own §17
// example JSON already nests "riskLevel" in the analysis output.
model AiInsight {
  id                 String      @id @default(uuid()) @db.Uuid
  clientId           String      @map("client_id") @db.Uuid
  checkInId          String?     @map("check_in_id") @db.Uuid
  riskLevel          AiRiskLevel @map("risk_level")
  confidence         Decimal     @db.Decimal(3, 2)
  insights           String[]
  recommendedActions String[]    @map("recommended_actions")
  reasoning          String      @db.Text
  createdAt          DateTime    @default(now()) @map("created_at")

  client  Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  checkIn DailyCheckIn? @relation(fields: [checkInId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@map("ai_insights")
}

// Structured fields are computed deterministically (same data Phase 3's
// progress charts read); only aiSummary/wins/problems/suggestedActions come
// from the model. Coach-triggered manually — no cron/job queue yet (Phase 7).
model WeeklyReport {
  id                    String   @id @default(uuid()) @db.Uuid
  clientId              String   @map("client_id") @db.Uuid
  weekStart             DateTime @map("week_start") @db.Date
  weekEnd               DateTime @map("week_end") @db.Date
  overallProgressPct    Decimal? @map("overall_progress_pct") @db.Decimal(5, 2)
  weightChangeKg        Decimal? @map("weight_change_kg") @db.Decimal(5, 2)
  workoutAdherencePct   Int?     @map("workout_adherence_pct")
  nutritionAdherencePct Int?     @map("nutrition_adherence_pct")
  avgSteps              Int?     @map("avg_steps")
  avgSleepHours         Decimal? @map("avg_sleep_hours") @db.Decimal(3, 1)
  wins                  String[]
  problems              String[]
  aiSummary             String   @map("ai_summary") @db.Text
  suggestedActions      String[] @map("suggested_actions")
  createdAt             DateTime @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, weekStart])
  @@map("weekly_reports")
}

// One row per AI call (chat turn, analysis, report) regardless of outcome —
// PRD §30's explicit "track request count, tokens, estimated cost, latency,
// errors" ask, satisfied directly rather than derived from logs elsewhere.
model AiUsageLog {
  id               String   @id @default(uuid()) @db.Uuid
  clientId         String?  @map("client_id") @db.Uuid
  feature          String
  model            String
  inputTokens      Int      @map("input_tokens")
  outputTokens     Int      @map("output_tokens")
  estimatedCostUsd Decimal  @map("estimated_cost_usd") @db.Decimal(8, 4)
  latencyMs        Int      @map("latency_ms")
  success          Boolean
  errorMessage     String?  @map("error_message")
  createdAt        DateTime @default(now()) @map("created_at")

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  // Phase 8 platform-wide AI usage aggregate — the index above is
  // clientId-first, useless for a global "usage in the last N days" scan.
  @@index([createdAt])
  @@map("ai_usage_logs")
}

// ---------------------------------------------------------------------------
// Phase 5: coach-client messaging and the notification center (PRD §20-21).
// ---------------------------------------------------------------------------

// No separate Conversation entity — CoachClient.clientId is already unique
// (exactly one coach per client), so `clientId` alone identifies "the
// conversation with this client," the same way DailyCheckIn/ClientNote need
// no parent row either.
model Message {
  id             String            @id @default(uuid()) @db.Uuid
  clientId       String            @map("client_id") @db.Uuid
  senderRole     MessageSenderRole @map("sender_role")
  content        String?           @db.Text
  attachmentUrl  String?           @map("attachment_url")
  attachmentType String?           @map("attachment_type")
  attachmentName String?           @map("attachment_name")
  // Set when the *other* role opens the thread — read/unread needs no
  // per-recipient table since a thread has exactly one other party.
  readAt         DateTime?         @map("read_at")
  createdAt      DateTime          @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@map("messages")
}

model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  type       NotificationType
  title      String
  body       String           @db.Text
  entityType String?          @map("entity_type")
  entityId   String?          @map("entity_id") @db.Uuid
  readAt     DateTime?        @map("read_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Phase 6: subscriptions and payments (PRD §24). Plan limits (client caps,
// prices) live in code (backend/src/config/plan-limits.ts), never here or
// scattered across the app — this table only tracks which plan a coach is on.
// ---------------------------------------------------------------------------

model Subscription {
  id               String             @id @default(uuid()) @db.Uuid
  // Unique: exactly one subscription row per coach — upgrades/downgrades
  // update this row in place rather than creating a new one.
  coachId          String             @unique @map("coach_id") @db.Uuid
  plan             SubscriptionPlan   @default(STARTER)
  status           SubscriptionStatus @default(ACTIVE)
  // Null for Starter (free, never expires) and whenever a paid plan has
  // lapsed back to Starter. Checked lazily on read (subscription.service.ts
  // #ensureCurrent), not by a scheduled sweep — so `status` alone can be
  // stale for a coach who hasn't hit a subscription endpoint recently; Phase
  // 8's churn metric recomputes the effective status from this field
  // instead of trusting `status` directly.
  currentPeriodEnd DateTime?          @map("current_period_end")
  razorpayOrderId  String?            @map("razorpay_order_id")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  coach Coach @relation(fields: [coachId], references: [id], onDelete: Cascade)

  // Phase 8 churn/conversion aggregate.
  @@index([status])
  @@map("subscriptions")
}

model Payment {
  id                String           @id @default(uuid()) @db.Uuid
  coachId           String           @map("coach_id") @db.Uuid
  plan              SubscriptionPlan
  amountInPaise     Int              @map("amount_in_paise")
  currency          String           @default("INR")
  status            PaymentStatus
  razorpayOrderId   String           @map("razorpay_order_id")
  razorpayPaymentId String?          @map("razorpay_payment_id")
  createdAt         DateTime         @default(now()) @map("created_at")

  coach Coach @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@index([coachId, createdAt])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Phase 7: Redis-backed background jobs and web push (PRD §28, §21).
// ---------------------------------------------------------------------------

// One row per subscribed browser/device — a user can have several. Endpoint
// is unique since the browser's push service assigns it and it identifies
// the subscription; p256dh/auth are the keys web-push needs to encrypt a
// payload to that endpoint.
model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}
