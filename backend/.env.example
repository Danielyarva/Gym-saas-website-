# Postgres connection used by Prisma (see prisma/schema.prisma)
DATABASE_URL="postgresql://aicoachos:aicoachos_dev_password@localhost:5432/aicoachos_dev?schema=public"

# HTTP server
PORT=4000
NODE_ENV=development

# Must match the origin the Next.js frontend is served from — CORS allows only this one origin.
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:4000"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1

# argon2id parameters (OWASP baseline; tune per deployment hardware)
ARGON2_MEMORY_COST_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Email provider — Phase 1 sends are fire-and-forget (no queue yet).
# Leave EMAIL_API_KEY unset in development: emails are logged to the console instead of sent.
EMAIL_API_KEY=""
EMAIL_FROM="AI Coach OS <no-reply@aicoachos.example>"

# Seed-only admin account (backend/prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@aicoachos.example"
SEED_ADMIN_PASSWORD="ChangeMe123!"

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
SHADOW_DATABASE_URL="postgresql://aicoachos:aicoachos_dev_password@localhost:5432/aicoachos_shadow?schema=public"
TRUST_PROXY_HOPS=0
